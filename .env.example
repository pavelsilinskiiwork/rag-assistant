# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Which provider answers by default: anthropic or groq
LLM_PROVIDER=groq
# Optional model overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_MODEL=openai/gpt-oss-120b

# Public demo settings (leave unset for local development)
# DEMO_MODE=1              uploads off, rate limits on
# RATE_LIMIT_PER_HOUR=10   per visitor
# DAILY_LIMIT=150          all visitors together
# FALLBACK_PROVIDER=anthropic   used when the default provider hits its rate limit
# TRUST_PROXY=1            set on Render/Fly so the visitor IP is read from X-Forwarded-For
