# Copy this file to .env and fill in the values you need. Never commit .env.
# Windows (cmd): copy .env.example .env
# Write values without quotes and without spaces around "=".

# ---- Which model provider answers: anthropic | groq | bedrock ----
LLM_PROVIDER=groq

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Groq (free plan has rate limits instead of a price) ----
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---- AWS Bedrock (Converse API) ----
# Auth: a Bedrock API key, or the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
# Model or inference profile ID from the Bedrock console (the "us." prefix is a cross-region profile).
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ---- Retrieval ----
# Keep only chunks within this distance of the best match (default 0.35, "none" disables it).
# RELEVANCE_MARGIN=0.35

# ---- Public demo (leave unset for local development) ----
# DEMO_MODE=1                    # uploads disabled, rate limits on
# RATE_LIMIT_PER_HOUR=10         # per IP
# DAILY_LIMIT=150                # all visitors together
# FALLBACK_PROVIDER=anthropic    # used when the first provider is rate limited
# TRUST_PROXY=1                  # behind a reverse proxy (Render): read the client IP from X-Forwarded-For
# CORS_ORIGINS=https://pavelsilinskiiwork.github.io   # origins allowed to call the API from a browser
